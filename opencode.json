{
  "$schema": "https://opencode.ai/config.json",
  "subagent_depth": 2,
  "permission": "allow",
  "mcp": {
    "figma-console": {
      "command": [
        "npx",
        "-y",
        "figma-console-mcp@1.36.0"
      ],
      "environment": {
        "ENABLE_MCP_APPS": "true",
        "FIGMA_ACCESS_TOKEN": "{env:FIGMA_ACCESS_TOKEN}"
      },
      "enabled": true,
      "timeout": 120000,
      "type": "local"
    },
    "clickup": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote@0.1.38",
        "https://mcp.clickup.com/mcp"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "github": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "AUTH_TOKEN=\"$(gh auth token)\" && [ -n \"$AUTH_TOKEN\" ] && export AUTH_TOKEN && exec npx -y mcp-remote@0.1.38 https://api.githubcopilot.com/mcp/ --header 'Authorization: Bearer ${AUTH_TOKEN}'"
      ],
      "enabled": true,
      "timeout": 120000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "sentry": {
      "type": "remote",
      "url": "https://mcp.sentry.dev/mcp/gohighlevel/revex_platform-billing",
      "oauth": {},
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "octocode": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@octocodeai/mcp@17.0.1"
      ],
      "environment": {
        "ENABLE_LOCAL": "false",
        "ENABLE_CLONE": "false"
      },
      "enabled": true,
      "timeout": 120000
    },
    "agent-browser": {
      "type": "local",
      "command": [
        "agent-browser",
        "mcp"
      ],
      "enabled": true
    },
    "caveman": {
      "type": "local",
      "command": [
        "uvx",
        "--from",
        "caveman-mcp",
        "--with",
        "mcp<2.0",
        "caveman-mcp"
      ],
      "enabled": true
    },
    "drawio": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "drawio-mcp-server@2.2.0",
        "--host",
        "127.0.0.1"
      ],
      "enabled": true,
      "timeout": 120000
    }
  },
